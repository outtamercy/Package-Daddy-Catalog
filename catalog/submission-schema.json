{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Package Daddy catalog submission",
  "type": "object",
  "required": ["schema_version", "operation", "record", "local_review"],
  "properties": {
    "schema_version": { "const": 1 },
    "operation": { "enum": ["add", "update", "comment"] },
    "record": {
      "type": "object",
      "required": ["id", "name", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 160 },
        "kind": { "enum": ["mo2-plugin", "mo2-tool", "mo2-theme"] },
        "archive_terms": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 2, "maxLength": 48 } },
        "nexus_url": { "type": "string", "format": "uri" },
        "source_url": { "type": "string", "format": "uri" },
        "discord_url": { "type": "string", "format": "uri" },
        "wiki_url": { "type": "string", "format": "uri" },
        "note": { "type": "string", "maxLength": 700 }
      },
      "additionalProperties": false
    },
    "comment": {
      "type": "object",
      "required": ["kind", "text", "evidence_url"],
      "properties": {
        "kind": { "enum": ["compatibility", "conflict", "dependency", "install-note", "correction"] },
        "text": { "type": "string", "minLength": 4, "maxLength": 500 },
        "evidence_url": { "type": "string", "format": "uri" },
        "related_package_ids": { "type": "array", "maxItems": 6, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$" } }
      },
      "additionalProperties": false
    },
    "local_review": {
      "type": "object",
      "required": ["verdict"],
      "properties": {
        "verdict": { "const": "passed-local-review" },
        "checked_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
